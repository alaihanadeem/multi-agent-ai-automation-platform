      "name": "Get Company DNA"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer request:\n{{ $json.user_message || $json.customer_message || $json.chatInput || $('When Executed by Another Workflow').first()?.json?.user_message || '' }}\n\nCompany DNA:\n{{ JSON.stringify($json.company_dna || $('Get Company DNA').first()?.json || {}) }}\n\nClient Details:\n- Customer Name: {{ $('When Executed by Another Workflow').first()?.json?.customer_name || 'Valued Client' }}\n- Requested Service: {{ $('When Executed by Another Workflow').first()?.json?.requested_service || 'Cybersecurity Solutions' }}",
        "options": {
          "systemMessage": "=You are an expert SMB Marketing Campaign Agent and Content Specialist.\n\nCRITICAL DIRECTIVE ON TRUTH & RELEVANCE:\n- YOU MUST EXPLICITLY ADDRESS the customer's request. The customer specifically asked for: promotional discounts, newsletters, and security whitepapers. \n- You MUST mention these exact items in your content, providing actual mock details, whitepaper titles, or discount summaries instead of a generic cybersecurity pitch.\n- NEVER use square brackets or placeholder tags like [Recipient's Name], [Company DNA], or [Email link]. Write clean, ready-to-use marketing copy.\n\nCreate a campaign responding directly to the customer's request containing these exact JSON keys:\n- campaign_name\n- campaign_type (must be: promotional)\n- target_audience\n- channel (must be: whatsapp or email)\n- subject\n- content (must explicitly include promotional discounts, newsletters, and security whitepaper details with NO brackets)\n\nReturn ONLY a single valid JSON object. \nNo markdown blocks (do not use ```json). \nNo explanations.\n\nOutput exactly this structure:\n{\n  \"campaign_name\": \"\",\n  \"campaign_type\": \"\",\n  \"target_audience\": \"\",\n  \"channel\": \"\",\n  \"subject\": \"\",\n  \"content\": \"\"\n}\n\nIncoming Customer Request:\n {{ $('When Executed by Another Workflow').item.json.customer_message }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -128,
        0
      ],
      "id": "73773acf-71ff-4087-a2bb-39c9ee28d586",
      "name": "Marketing Campaign Agent"
    },
    {
      "parameters": {
        "model": "qwen2.5:1.5b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -128,
        224
      ],
      "id": "5ff65256-0627-4ac1-9eba-8c6b1c5b98d5",
      "name": "Ollama Chat Model",
      "credentials": {
        "ollamaApi": {
          "id": "uqB8SubYvJOokDyY",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output ? $json.output : ($json.text ? $json.text : ($json.content ? $json.content :$json));\n\nif (!raw || (typeof raw === 'object' && Object.keys(raw).length === 0)) {\n  throw new Error('Marketing Campaign Agent returned empty output.');\n}\n\nlet campaign;\n\ntry {\n  campaign = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (error) {\n  campaign = { content: String(raw) };\n}\n\nconst name = String(campaign.campaign_name ? campaign.campaign_name : 'Marketing Campaign').trim();\nconst type = String(campaign.campaign_type ? campaign.campaign_type : 'General').trim();\nconst audience = String(campaign.target_audience ? campaign.target_audience : 'All Customers').trim();\nconst channel = String(campaign.channel ? campaign.channel : 'Email').trim();\nconst subject = String(campaign.subject ? campaign.subject : '').trim();\nconst content = String(campaign.content ? campaign.content : (campaign.message ? campaign.message : '')).trim();\n\nconst assistantMessage = `Campaign created successfully!\n• Name: ${name}\n• Type: ${type}\n• Channel: ${channel}\n• Target Audience: ${audience}${subject ? `\\n• Subject: ${subject}` : ''}`;\n\nreturn [{\n  json: {\n    campaign_name: name,\n    campaign_type: type,\n    target_audience: audience,\n    channel: channel,\n    subject: subject,\n    content: content,\n    assistant_message: assistantMessage,\n    message: assistantMessage\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        0
      ],
      "id": "0ae35fd3-b9b5-4ad5-81f8-26aab34b35a3",
      "name": "Parse Campaign Output"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst content = String(data.content || '');\n\nconst recipientMatch = content.match(/total recipients:\\s*(\\d+)/i);\nconst audienceMatch = String(data.target_audience || '').match(/(\\d+)/);\n\nconst companyId = String(\n  data.company_id || \n$('When Executed by Another Workflow').first()?.json?.company_id || \n  'COMP001'\n).trim();\n\nreturn [{\n  json: {\n    campaign_id: 'CMP-' + String($execution.id),\n    company_id: companyId,\n    campaign_name: String(data.campaign_name || '').trim(),\n    campaign_type: String(data.campaign_type || '').trim(),\n    target_audience: String(data.target_audience || '').trim(),\n    channel: String(data.channel || '').trim(),\n    subject: String(data.subject || '').trim(),\n    content: content.trim(),\n    status: 'draft',\n    scheduled_at: '',\n    sent_at: '',\n    total_recipients: Number(\n      data.total_recipients ||\n      audienceMatch?.[1] ||\n      recipientMatch?.[1] ||\n      0\n    ),\n    responses: 0,\n    conversions: 0,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
