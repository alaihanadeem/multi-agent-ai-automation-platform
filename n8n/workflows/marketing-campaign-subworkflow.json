    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst recipients = Number(data.total_recipients || 0);\nconst responses = Number(data.responses || 0);\nconst conversions = Number(data.conversions || 0);\n\nconst responseRate = recipients > 0\n  ? ((responses / recipients) * 100).toFixed(2)\n  : '0.00';\n\nconst conversionRate = recipients > 0\n  ? ((conversions / recipients) * 100).toFixed(2)\n  : '0.00';\n\nreturn [{\n  json: {\n    ...data,\n    response_rate: Number(responseRate),\n    conversion_rate: Number(conversionRate),\n    analytics_status: 'completed'\n  }\n}];"
      },
