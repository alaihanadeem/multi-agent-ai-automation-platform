      "parameters": {
        "jsCode": "const result = $json;\n\nlet finalMessage = result.output || result.message || result.text || result.response || result.status;\n\nif (!finalMessage) {\n  if (typeof result === 'string') {\n    finalMessage = result;\n  } else {\n    const values = Object.values(result).filter(val => typeof val === 'string' && val.trim() !== '');\n    finalMessage = values.length > 0 ? values[0] : \"Request processed successfully.\";\n  }\n}\n\nreturn [{\n  json: {\n    output: finalMessage\n  }\n}];"
