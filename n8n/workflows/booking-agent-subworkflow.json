      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimits) {\n  staticData.rateLimits = {};\n}\nconst now = Date.now();\nconst WINDOW_MS = 60000;\nconst MAX_REQUESTS = 5;\nconst results = [];\nfor (const item of $input.all()) {\n  const sessionId = item.json.sessionId || 'unknown';\n  if (!staticData.rateLimits[sessionId]) {\n    staticData.rateLimits[sessionId] = [];\n  }\n  staticData.rateLimits[sessionId] = staticData.rateLimits[sessionId].filter(ts => now - ts < WINDOW_MS);\n  const requestCount = staticData.rateLimits[sessionId].length;\n  if (requestCount >= MAX_REQUESTS) {\n    item.json.rateLimited = true;\n  } else {\n    staticData.rateLimits[sessionId].push(now);\n    item.json.rateLimited = false;\n  }\n  results.push(item);\n}\nreturn results;"
