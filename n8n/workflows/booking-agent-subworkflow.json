      "parameters": {
        "jsCode": "const input = ($json.chatInput || \"\").toLowerCase().trim();\nconst confirmWords = [\"yes\", \"confirm\", \"book it\", \"go ahead\", \"yes confirm\", \"sure\", \"correct\"];\nconst isConfirmation = confirmWords.some(word => input === word || input.startsWith(word));\n\nreturn [{\n  json: {\n    ...$json,\n    toolAllowed: isConfirmation\n  }\n}];"
