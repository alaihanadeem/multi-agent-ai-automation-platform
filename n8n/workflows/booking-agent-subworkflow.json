{
  "name": "Review & Feedback subworkflow",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer Message: {{ $json.customer_message || $json.body?.customer_message || 'No message provided' }}",
        "options": {
          "systemMessage": "You are an SMB Customer Review & Feedback Agent.\n\nYour job is ONLY to analyze customer feedback.\n\nExtract:\n- rating\n- feedback\n- sentiment\n- category\n- issue\n- human_handoff\n\nRules:\n- Do not invent information.\n- If rating is not provided, use 0.\n- If information is unavailable, use an empty string \"\".\n- human_handoff must be true only when the customer reports a serious complaint, unresolved issue, or explicitly asks for human help.\n- sentiment must be one of: positive, neutral, negative.\n- category must be one of: praise, complaint, suggestion, service_quality, support_issue, general_feedback.\n\nReturn ONLY valid JSON:\n\n{\n  \"rating\": 0,\n  \"feedback\": \"\",\n  \"sentiment\": \"\",\n  \"category\": \"\",\n  \"issue\": \"\",\n  \"human_handoff\": false\n}\nYou are a Review & Feedback Agent. \nLook at the extracted sentiment and rating from the customer feedback:\n1. If sentiment is \"negative\" or rating <= 2: Apologize sincerely for the negative experience, address the specific issue mentioned, and assure them that support or management will look into it.\n2. If sentiment is \"positive\" or rating >= 4: Thank them warmly for their positive feedback.\n3. Keep the response professional, empathetic, and concise."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -1072,
        0
      ],
      "id": "77cbd4eb-0731-429f-924b-aa3f492eaea5",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "qwen2.5:1.5b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -1072,
        208
      ],
      "id": "919ebb9b-0899-4327-81a2-97b855816de6",
      "name": "Ollama Chat Model",
      "credentials": {
        "ollamaApi": {
          "id": "uqB8SubYvJOokDyY",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json.text || $json.response || $json.message;\n\nif (!raw) {\n  throw new Error('Feedback Agent returned empty output.');\n}\n\nlet feedback;\n\nif (typeof raw === 'string') {\n  let text = raw.replace(/```json|```/gi, '').trim();\n\n  const start = text.indexOf('{');\n  const end = text.lastIndexOf('}');\n\n  if (start === -1 || end === -1 || end <= start) {\n    feedback = {\n      rating: 0,\n      feedback: text,\n      sentiment: 'neutral',\n      category: 'general_feedback',\n      issue: text,\n      human_handoff: false\n    };\n  } else {\n    try {\n      feedback = JSON.parse(text.slice(start, end + 1));\n    } catch (error) {\n      feedback = {\n        rating: 0,\n        feedback: text,\n        sentiment: 'neutral',\n        category: 'general_feedback',\n        issue: text,\n        human_handoff: false\n      };\n    }\n  }\n} else if (typeof raw === 'object' && raw !== null) {\n  feedback = raw;\n} else {\n  feedback = {\n    rating: 0,\n    feedback: String(raw),\n    sentiment: 'neutral',\n    category: 'general_feedback',\n    issue: String(raw),\n    human_handoff: false\n  };\n}\n\nreturn [{\n  json: {\n    ...$json,\n    rating: Number(feedback.rating || 0),\n    feedback: String(feedback.feedback || '').trim(),\n    sentiment: String(feedback.sentiment || 'neutral').trim(),\n    category: String(feedback.category || 'general_feedback').trim(),\n    issue: String(feedback.issue || '').trim(),\n    human_handoff: feedback.human_handoff === true || String(feedback.human_handoff).toLowerCase() === 'true'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -704,
        0
      ],
      "id": "26c9628d-8548-457c-9810-be82a045dcb0",
      "name": "Parse Feedback Output"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst execId = String($execution.id || Date.now());\n\nreturn [{\n  json: {\n    ...data,\n    \n    feedback_id: 'FB-' + execId,\n    company_id: String(data.company_id || 'COMP001').trim(),\n    session_id: String(data.session_id || 'SESS-' + execId).trim(),\n    \n    customer_name: String(data.customer_name || data.name || '').trim(),\n    email: String(data.email || '').trim(),\n    \n    rating: Number(data.rating || 0),\n    feedback: String(data.feedback || '').trim(),\n    sentiment: String(data.sentiment || 'neutral').trim(),\n    category: String(data.category || 'general_feedback').trim(),\n    issue: String(data.issue || '').trim(),\n    human_handoff: data.human_handoff === true,\n    \n    status: 'new',\n    created_at: new Date().toISOString()\n  }\n}];"
      },
