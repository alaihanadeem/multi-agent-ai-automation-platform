    {
      "parameters": {
        "jsCode": "const output = $json.output || '';\n\nconst initialData = $('When Executed by Another Workflow').first().json || {};\n\nconst name = initialData.customer_name || '';\nconst phone = initialData.phone || '';\nconst service = initialData.requested_service || '';\nconst date = initialData.appointment_date || '';\nconst time = initialData.appointment_time || '';\n\nconst isComplete = Boolean(name && phone && date && time);\nconst isAskingForInfo = output.toLowerCase().includes('can i please') || output.toLowerCase().includes('please provide') || output.toLowerCase().includes('what');\n\nconst confirmation = isComplete && !isAskingForInfo;\n\nreturn [{\n  json: {\n    name: name,\n    phone: phone,\n    email: initialData.email || '',\n    service: service,\n    date: date,\n    time: time,\n    customer_message: initialData.customer_message || '',\n    confirmation: confirmation,\n    assistant_message: output\n  }\n}];"
      },
