    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst accept = $('Accept Follow-up').first().json;\n\nconst nextStep = String(accept.next_step || '').trim().toLowerCase();\nconst intent = String(accept.intent || '').trim().toLowerCase();\nconst message = String(accept.customer_message || '').trim().toLowerCase();\n\nconst optOutFlag = accept.opt_out === true || input.opt_out === true;\n\nlet action = 'nurture';\n\nif (\n  optOutFlag ||\n  /\\b(stop|unsubscribe|opt[- ]?out)\\b/.test(message) ||\n  message.includes('do not contact') ||\n  message.includes(\"don't contact\")\n) {\n  action = 'opt_out';\n} else if (/\\b(human|representative|real person|live agent)\\b/.test(message)) {\n  action = 'human_handoff';\n} else if (\n  nextStep === 'request_quote' ||\n  /\\b(quote|quotation|pricing|price|cost)\\b/.test(message)\n) {\n  action = 'quote';\n} else if (\n  nextStep === 'request_appointment' ||\n  /\\b(appointment|schedule|book|meeting)\\b/.test(message)\n) {\n  action = 'appointment';\n} else if (\n  intent === 'purchase_intent' ||\n  nextStep === 'sales' ||\n  /\\b(sales|buy|purchase|upgrade|plan|subscription|package|tier)\\b/.test(message)\n) {\n  action = 'sales';\n} else if (\n  nextStep === 'support' ||\n  /\\b(ticket|urgent critical issue)\\b/.test(message)\n) {\n  action = 'human_handoff';\n}\n\nreturn [{\n  json: {\n    ...input,\n    ...accept,\n    follow_up_action: action,\n    follow_up_status: 'action_determined',\n    updated_at: new Date().toISOString()\n  }\n}];"
      },
