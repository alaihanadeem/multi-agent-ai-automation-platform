            "company_id": "={{$json.company_id}}",
            "approval_type": "pricing_validation",
            "requested_action": "={{$json.pricing_reason}}",
            "requested_price": "={{$json.quoted_price}}",
            "requested_discount": "={{$json.discount_percent}}",
            "status": "pending",
            "requested_by": "Quote & Proposal Agent",
            "approved_by": "=",
            "updated_at": "={{$now.toISO()}}",
