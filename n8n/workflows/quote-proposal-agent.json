    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst dna = $('Merge').first().json;\nconst existing =$('Check Existing Quote').first().json;\n\nfunction getValue(obj, name) {\n  const key = Object.keys(obj).find(\n    k => k.trim() === name\n  );\n  return key ? obj[key] : '';\n}\n\nreturn [{\n  json: {\n    quote_id: String(getValue(existing, 'quote_id')),\n    opportunity_id: String(getValue(existing, 'opportunity_id')),\n    lead_id: String(getValue(existing, 'lead_id')),\n    company_id: String(input.company_id || dna.company_id || ''),\n    session_id: String(getValue(existing, 'session_id')),\n    customer_name: String(input.customer_name || ''),\n    email: String(getValue(existing, 'email')),\n    requested_service: String(input.requested_service || '').trim(),\n\n    services: String(dna.services || '').trim(),\n    pricing: String(dna.pricing || '').trim(),\n    policies: String(dna.policies || '').trim(),\n    permissions: String(dna.permissions || '').trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        240
      ],
      "id": "a8512e96-ae0f-4035-93ab-86fde6b2a7b3",
      "name": "Normalize Existing Quote"
    },
    {
      "parameters": {
        "jsCode": "const raw = $('Quote Agent').first().json.output \vert{}\vert{} '';\n\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\n\nif (!match) {\n  throw new Error('No JSON object found in Quote Agent output');\n}\n\nlet jsonStr = match[0];\n\njsonStr = jsonStr.replace(/:\\s*\\$([0-9,.]+)/g, ': \"$$1\"');\njsonStr = jsonStr.replace(/,\\s*([}\\\\]])/g, '$1');\n\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonStr);\n} catch (e) {\n  const cleaned = jsonStr.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n}\n\nreturn [{\n  json: parsed\n}];"
      },
