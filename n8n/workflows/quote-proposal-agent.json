      "id": "b9b1247e-8409-4e62-b952-c73f48c9c825",
      "name": "Create Quote Draft"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst requestedService = String(\n  input.requested_service || ''\n).trim();\n\nconst services = String(\n  input.services || ''\n).trim();\n\nconst pricing = String(\n  input.pricing || ''\n).trim();\n\nconst serviceMatch =\n  requestedService !== '' &&\n  services !== '' &&\n  (\n    services.toLowerCase().includes(requestedService.toLowerCase()) ||\n    requestedService.toLowerCase().includes(services.toLowerCase())\n  );\n\nconst pricingAvailable = pricing !== '';\n\nconst pricingValid = Boolean(\n  serviceMatch && pricingAvailable\n);\n\nreturn [{\n  json: {\n    quote_id: input.quote_id,\n    opportunity_id: input.opportunity_id,\n    lead_id: input.lead_id,\n    company_id: input.company_id,\n    session_id: input.session_id,\n    customer_name: input.customer_name,\n    email: input.email,\n    requested_service: requestedService,\n\n    services: services,\n    pricing: pricing,\n    policies: input.policies || '',\n    permissions: input.permissions || '',\n\n    service_match: serviceMatch,\n    pricing_available: pricingAvailable,\n    pricing_valid: pricingValid,\n    approval_required: !pricingValid,\n\n    pricing_reason: pricingValid\n      ? 'Service and company pricing information are available.'\n      : 'Pricing or service information requires clarification or approval.'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        336
      ],
